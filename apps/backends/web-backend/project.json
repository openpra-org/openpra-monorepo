{
  "name": "backends-web-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "tags": ["scope:server"],
  "sourceRoot": "apps/backends/web-backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/backends/web-backend",
        "generatePackageJson": false,
        "generateLockfile": false,
        "main": "apps/backends/web-backend/src/main.ts",
        "tsConfig": "apps/backends/web-backend/tsconfig.app.json",
        "assets": [{ "glob": "**/*.pdf", "input": "apps/backends/web-backend/example-documents", "output": "example-documents" }],
        "webpackConfig": "apps/backends/web-backend/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "backends-web-backend:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "backends-web-backend:build:development"
        },
        "production": {
          "buildTarget": "backends-web-backend:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.app.json",
        "cwd": "apps/backends/web-backend"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/backends/web-backend/test/jest.config.ts"
      }
    },
    "e2e": {
      "executor": "@nx/jest:jest",
      "dependsOn": [
        {
          "projects": ["solvers-praxis-node"],
          "target": "build"
        }
      ],
      "options": {
        "jestConfig": "apps/backends/web-backend/test/jest.e2e.config.ts",
        "passWithNoTests": false
      }
    }
  }
}
