{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.spec.tsx",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "webpack.config.js"
  ]
}
