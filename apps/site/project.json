{
  "name": "site",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["scope:client"],
  "sourceRoot": "apps/site/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "pnpm build",
        "cwd": "apps/site"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/site"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "pnpm preview",
        "cwd": "apps/site"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm check",
        "cwd": "apps/site"
      }
    }
  }
}
