---
const { path = '/' } = Astro.props;
const links = [
  ['/platform/', 'Platform'],
  ['/models/', 'Models'],
  ['/schema/', 'Schema'],
  ['/research/', 'Research'],
  ['/about/', 'About'],
  ['https://docs-dev.openpra.org', 'Docs'],
];
---
<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/" aria-label="OpenPRA, home">
      <img src="/brand/mark-violet.svg" alt="" width="40" height="40" />
      <span class="nav__word">OpenPRA</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav__links">
        {links.map(([href, label]) => (
          <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
        ))}
        <li><a class="btn" href="https://main-dev.openpra.org">Open the app</a></li>
      </ul>
    </nav>
    <button class="nav__toggle btn btn--ghost" aria-expanded="false" aria-label="Menu">Menu</button>
  </div>
</header>
