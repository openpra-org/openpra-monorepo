---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" path="/404/">
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1 style="max-width:20ch">That page is not in the set</h1>
      <p class="lede" style="margin-top:1.1rem">
        Completeness was always the hard part. This address does not resolve to
        anything — try the platform overview, the models, or the schema
        reference.
      </p>
      <div class="btn-row">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--ghost" href="/platform/">Platform</a>
        <a class="btn btn--ghost" href="/models/">Models</a>
        <a class="btn btn--ghost" href="https://docs-dev.openpra.org">Docs</a>
      </div>
    </div>
  </section>
</Base>
