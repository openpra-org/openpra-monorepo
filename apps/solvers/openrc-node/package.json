{
  "name": "openrc-node",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Node-API bindings for the OpenPRA OpenRC consequence engine",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "protocol.js",
    "protocol.d.ts",
    "*.node",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "private": true,
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:linux": "napi build --platform --release --target x86_64-unknown-linux-gnu",
    "build:windows": "napi build --platform --release --target x86_64-pc-windows-msvc",
    "format": "cargo fmt --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "test": "node --test test/addon-load.spec.mjs test/request-envelope.spec.mjs test/reference-cases.spec.mjs test/engine-errors.spec.mjs test/run-behaviour.spec.mjs test/robustness.spec.mjs test/protocol.spec.mjs",
    "test:linux": "node --test test/linux-load.spec.mjs",
    "test:windows": "node --test test/windows-load.spec.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6"
  },
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "openrc-node",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  }
}
