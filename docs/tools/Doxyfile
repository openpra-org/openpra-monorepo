PROJECT_NAME           = "SCRAM"
OUTPUT_DIRECTORY       = docs/public/api/cpp/scram
GENERATE_HTML          = YES
GENERATE_XML           = NO
HTML_OUTPUT            = .
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
JAVADOC_AUTOBRIEF      = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
INTERNAL_DOCS          = NO

