{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPoints": ["../../apps/interfaces/shared-types"],
  "entryPointStrategy": "expand",
  "tsconfig": "../../apps/interfaces/shared-types/tsconfig.lib.json",
  "out": "../api/ts/shared-types",
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "exclude": ["**/node_modules/**", "**/*.spec.ts", "**/*.d.ts"],
  "entryFileName": "index",
  "name": "Shared Types",
  "readme": "stubs/shared-types.md",
  "skipErrorChecking": true,
  "logLevel": "Warn"
}
