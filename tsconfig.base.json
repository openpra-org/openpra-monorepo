{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compileOnSave": false,
  "incremental": false,
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "interfaces-shared-types": ["apps/interfaces/shared-types/index.ts"],
      "interfaces-shared-types/*": ["apps/interfaces/shared-types/*"],
      "interfaces-mef-types": ["apps/interfaces/mef-types/index.ts"],
      "interfaces-mef-types/*": ["apps/interfaces/mef-types/*"]
    },
    "types": ["jest", "node", "@types/jest"],
    "strictNullChecks": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
